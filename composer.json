{
  "name": "muhharis99/api-satu-sehat",
  "description": "SATUSEHAT FHIR simulator built with CodeIgniter 4",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
